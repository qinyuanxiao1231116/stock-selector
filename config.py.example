# 复制此文件为 config.py 并填入实际值
# cp config.py.example config.py

import os

# Server酱推送密钥（https://sct.ftqq.com/）
# 免费每天5条，支持多人推送，每人一个 SendKey
_env_key = os.environ.get('SEND_KEY', '')
SEND_KEYS = [_env_key] if _env_key else [
    'YOUR_SEND_KEY_HERE',
    # 添加更多人的 SendKey：
    # 'ANOTHER_SEND_KEY_HERE',
]

# WxPusher推送配置（https://wxpusher.zjiecode.com/）
# 免费不限条数，需先在官网创建应用获取AppToken，用户扫码关注后获取UID
WXPUSHER_APP_TOKEN = os.environ.get('WXPUSHER_APP_TOKEN', '')  # 填入你的 AppToken，留空则不启用
WXPUSHER_UIDS = [
    # 'UID_xxxxxxxx',  # 每个关注用户一个UID
]

# ===== 早盘集合竞价选股条件 =====
# 竞价金额阈值（元）：大于等于该值
AUCTION_AMOUNT_THRESHOLD = 20000000  # 2000万

# 竞价涨幅区间（%）：>= 最小值 且 <= 最大值
AUCTION_GAIN_MIN = 3.0
AUCTION_GAIN_MAX = 8.0

# 9:25 涨幅 与 9:24 涨幅之差阈值（%）：9:25涨幅 - 9:24涨幅 >= 该值
# 即最后一分钟竞价拉升幅度至少为该值
AUCTION_GAIN_DIFF_THRESHOLD = 2.0

# 流通市值上限（元）：不大于该值
AUCTION_FLOAT_MV_MAX = 20000000000  # 200亿

# ===== 尾盘选股条件（14:55） =====
# 方案1：涨停后缩量回踩
LATE_SCHEME1_LOOKBACK_DAYS = 15   # 回溯交易日数（找涨停）
LATE_SCHEME1_VOLUME_RATIO = 3.0   # 成交量 <= 最大成交量 / 该值（1/3）

# 方案2：连阳承接不破均线
LATE_SCHEME2_MIN_BULLISH_DAYS = 6  # 最少连续阳线天数
LATE_SCHEME2_MA_PERIOD = 5         # 均线周期（不破该均线）

# 尾盘选股回溯K线天数（需 >= 方案1回溯天数）
LATE_LOOKBACK_DAYS = 20

# 日志文件路径
LOG_FILE = 'stock_selector.log'
